# Personal access token from https://app.asana.com/0/developer-console
ASANA_TOKEN=your_personal_access_token_here

# GID of the Asana workspace to extract users/projects from
ASANA_WORKSPACE_GID=your_workspace_gid_here

# Directory where per-entity JSON files are written (optional)
OUTPUT_DIR=./output

# Extraction interval: "5m" or "30s" (optional, defaults to 5m)
EXTRACT_INTERVAL=5m

# Per-cycle timeout: bounds a single extraction cycle (ListUsers + all
# writes + ListProjects + all writes). Assumes the workspace's full
# user+project pagination completes within this budget. (optional,
# defaults to 2m)
CYCLE_TIMEOUT=2m
